# Storefront (Next.js 14) — Biến Môi Trường

# ─── API URL (Client-side — Browser) ─────────────────────────────────────
# URL mà trình duyệt gọi trực tiếp (sau khi client-side hydration)
# Khi dev local: để trống (dùng rewrite proxy của Next.js)
# Khi production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=

# ─── Internal API URL (Server-side — SSR / Docker) ────────────────────────
# URL nội bộ dùng trong getServerSideProps / Server Components (bên trong Docker network)
# Khi dev local: http://localhost:5000
# Khi production Docker: http://backend:5000 (tên service trong docker-compose)
INTERNAL_API_URL=http://localhost:5000
