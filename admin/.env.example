# Admin Panel (Vite + React) — Biến Môi Trường

# ─── URL API Backend ─────────────────────────────────────────────────────
# Đây là URL mà trình duyệt của người dùng sẽ dùng để gọi API
# Khi dev local: http://localhost:5000/api/v1
# Khi production: https://api.yourdomain.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# ─── URL Trang Chủ Storefront ─────────────────────────────────────────────
# Dùng để link "Trở về Trang Chủ" trong Admin Header
# Khi dev local: http://localhost:3000
# Khi production: https://www.yourdomain.com
VITE_STOREFRONT_URL=http://localhost:3000
